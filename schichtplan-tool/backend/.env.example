# Copy to .env (or set these in your host's dashboard). Nothing here is needed
# to run locally: without DATABASE_URL the app uses a local SQLite file, and
# without SMTP_HOST invitation links are written to the server log.

# Signs the session cookie. Generate a long random value for any real deployment.
SECRET_KEY=

# Postgres connection string. Set this in production - a container's disk is
# wiped on restart, which would take every schedule with it.
DATABASE_URL=

# Which frontend origins may call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# Where the frontend lives; invitation links are built from this.
APP_BASE_URL=http://localhost:5173

# Mail. Leave SMTP_HOST empty to have invitations logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=schichtplan@example.com
